<% content_for :title, "#{@place.name} - #{@prefecture.name}" %>

<div class="max-w-2xl mx-auto px-6 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@prefecture.name}に戻る", prefecture_path(@prefecture), class: "text-blue-600 hover:underline text-sm" %>
  </div>

  <h1 class="text-3xl font-bold text-gray-800 mb-6"><%= @place.name %></h1>

  <div class="bg-white rounded-xl shadow-sm p-6 flex flex-col gap-4">
    <div>
      <p class="text-sm font-bold text-gray-500 mb-1">訪問状況</p>
      <% if @place.visited? %>
        <span class="text-sm bg-green-100 text-green-700 px-3 py-1 rounded-full">行ったことがある</span>
      <% elsif @place.want_to_visit? %>
        <span class="text-sm bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">行ってみたい</span>
      <% end %>
    </div>

    <% if @place.address.present? %>
      <div>
        <p class="text-sm font-bold text-gray-500 mb-1">住所</p>
        <p class="text-gray-700"><%= @place.address %></p>
      </div>
    <% end %>

    <% if @place.memo.present? %>
      <div>
        <p class="text-sm font-bold text-gray-500 mb-1">メモ</p>
        <p class="text-gray-700 whitespace-pre-wrap"><%= @place.memo %></p>
      </div>
    <% end %>

    <% if @place.address.blank? && @place.memo.blank? %>
      <p class="text-gray-400">住所・メモは登録されていません。</p>
    <% end %>
  </div>
</div>

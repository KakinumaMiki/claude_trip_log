<% content_for :title, "場所の追加 - #{@prefecture.name}" %>

<div class="max-w-2xl mx-auto px-6 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@prefecture.name}に戻る", prefecture_path(@prefecture), class: "text-blue-600 hover:underline text-sm" %>
  </div>

  <h1 class="text-3xl font-bold text-gray-800 mb-6">場所の追加</h1>

  <%= form_with model: [@prefecture, @place] do |f| %>
    <div class="bg-white rounded-xl shadow-sm p-6 flex flex-col gap-4">
      <div>
        <%= f.label :name, "場所の名前", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "例: 清水寺" %>
        <% @place.errors[:name].each do |msg| %>
          <p class="text-red-500 text-sm mt-1"><%= msg %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :status, "訪問状況", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= f.select :status,
              [["行ったことがある", "visited"], ["行ってみたい", "want_to_visit"]],
              { include_blank: "選択してください" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        <% @place.errors[:status].each do |msg| %>
          <p class="text-red-500 text-sm mt-1"><%= msg %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :address, "住所", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= f.text_field :address, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "例: 京都市東山区清水1丁目294" %>
      </div>

      <div>
        <%= f.label :memo, "メモ", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= f.text_area :memo, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "感想や覚えておきたいことなど" %>
      </div>

      <%= f.submit "追加する", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2 rounded-lg cursor-pointer" %>
    </div>
  <% end %>
</div>

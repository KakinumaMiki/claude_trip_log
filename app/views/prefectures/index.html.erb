<% content_for :title, "旅行記録マップ" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<script src="https://cdn.jsdelivr.net/npm/jquery@3/dist/jquery.min.js"></script>
<script src="/jmap.js"></script>

<%
  region_colors = {
    "北海道"     => { color: "#7baef7", hover: "#a8ccfa" },
    "東北"       => { color: "#6dcde8", hover: "#9de0f0" },
    "関東"       => { color: "#6dd4a4", hover: "#9de4c3" },
    "中部"       => { color: "#f5cb55", hover: "#f9dc88" },
    "近畿"       => { color: "#f5925e", hover: "#f8b590" },
    "中国"       => { color: "#e87ea8", hover: "#f0a8c8" },
    "四国"       => { color: "#b48fe0", hover: "#ccb3ec" },
    "九州・沖縄" => { color: "#5ecfb5", hover: "#90dfcc" },
  }
%>

<div class="flex flex-col" style="height: calc(100vh - 52px);">
  <div id="jmap" class="flex-1 map-container"></div>

  <div id="map-legend" class="bg-white border-t px-6 py-2 flex flex-wrap gap-4 text-sm text-gray-700">
    <% region_colors.each do |region, c| %>
      <span class="flex items-center gap-1">
        <span class="inline-block w-3 h-3 rounded-sm" style="background:<%= c[:color] %>"></span>
        <%= region %>
      </span>
    <% end %>
    <span class="ml-auto text-gray-400">クリックで都道府県ページへ</span>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const el = document.getElementById('jmap');
    if (!el || el.children.length > 0) return;

    const legendH = document.getElementById('map-legend').getBoundingClientRect().height;
    const mapH = window.innerHeight - 52 - legendH;

    $(el).jmap({
      width:  '100%',
      height: Math.floor(mapH) + 'px',
      backgroundPadding:        '30px',
      prefectureClass:          'prefecture',
      prefectureLineHoverColor: '#fff',
      fontColor:                '#fff',
      showRoundedPrefecture:    true,
      areas: [
        <% @prefectures.each do |pref| %>
          <% c = region_colors[pref.region] || { color: "#7baef7", hover: "#a8ccfa" } %>
          { code: <%= pref.code %>, color: "<%= c[:color] %>", hoverColor: "<%= c[:hover] %>" },
        <% end %>
      ],
      onSelect: function(e, data) {
        window.location.href = '/prefectures/' + data.code;
      }
    });
  });
</script>
